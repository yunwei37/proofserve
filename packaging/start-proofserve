#!/bin/sh
set -eu
if [ "$#" -eq 0 ]; then set -- --help; fi
case "$1" in
  serve|batch|measure)
    cd /opt/mathlib
    exec lake env /opt/proofserve/bin/proofserve "$@" \
      --repl /opt/repl/.lake/build/bin/repl \
      --project /opt/mathlib \
      --environment "$(cat /opt/proofserve-context)"
    ;;
  *)
    exec /opt/proofserve/bin/proofserve "$@"
    ;;
esac
